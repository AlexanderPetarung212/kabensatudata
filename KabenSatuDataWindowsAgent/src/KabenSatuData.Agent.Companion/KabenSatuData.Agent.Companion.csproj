<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AssemblyName>KabenSatuData.Agent.Companion</AssemblyName>
    <RootNamespace>KabenSatuData.Agent.Companion</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KabenSatuData.Agent.Contracts/KabenSatuData.Agent.Contracts.csproj" />
    <ProjectReference Include="../KabenSatuData.Agent.Core/KabenSatuData.Agent.Core.csproj" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250506" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
